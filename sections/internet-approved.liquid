{{ 'section-internet-approved.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <section class="internet-approved section-{{ section.id }}-padding">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <div class="internet-approved__header">
          <h2 class="internet-approved__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        </div>
      {%- endif -%}

      <div class="internet-approved__grid">
        {%- for block in section.blocks -%}
          <article class="internet-approved__card" {{ block.shopify_attributes }}>
            <a
              class="internet-approved__media-link"
              {% if block.settings.link != blank %}
                href="{{ block.settings.link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
            >
              <div class="internet-approved__media media media--transparent">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 1200
                    | image_tag:
                      widths: '400, 550, 750, 900, 1200',
                      sizes: '(min-width: 990px) calc((100vw - 14rem) / 3), (min-width: 750px) calc((100vw - 10rem) / 2), calc(100vw - 3rem)',
                      loading: 'lazy',
                      alt: block.settings.title | escape
                  }}
                {%- elsif block.settings.external_image != blank -%}
                  <img
                    src="{{ block.settings.external_image }}"
                    alt="{{ block.settings.title | escape }}"
                    loading="lazy"
                    width="800"
                    height="640"
                  >
                {%- else -%}
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg placeholder' }}
                {%- endif -%}
              </div>
            </a>

            <div class="internet-approved__content{% if block.settings.external_image != blank %} internet-approved__content--compact{% endif %}">
              {%- if block.settings.external_image == blank and block.settings.title != blank -%}
                <h3 class="internet-approved__card-title">{{ block.settings.title }}</h3>
              {%- endif -%}

              {%- if block.settings.external_image == blank and block.settings.text != blank -%}
                <div class="internet-approved__card-text rte">{{ block.settings.text }}</div>
              {%- endif -%}

              {%- if block.settings.button_label != blank -%}
                <a
                  class="internet-approved__link"
                  {% if block.settings.link != blank %}
                    href="{{ block.settings.link }}"
                  {% else %}
                    role="link"
                    aria-disabled="true"
                  {% endif %}
                >
                  <span>{{ block.settings.button_label }}</span>
                  <span class="internet-approved__arrow" aria-hidden="true"></span>
                </a>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "Internet approved",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Internet Approved"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h1",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ]
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Section spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "limit": 6,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "external_image",
          "label": "External image URL"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Glass Glow"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Beauty picks for a glass like finish</p>"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Internet approved",
      "blocks": [
        { "type": "card" },
        { "type": "card" },
        { "type": "card" }
      ]
    }
  ]
}
{% endschema %}
