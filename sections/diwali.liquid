
<section class="diwali-blast-section section-{{ section.id }}">
  <div class="diwali-blast-container">
    <div class="blast-center"></div>
    {% for i in (1..20) %}
      <div class="spark spark-{{ i }}"></div>
    {% endfor %}
  </div>
</section>

<style>
.diwali-blast-section {
  position: relative;
  overflow: hidden;
  background: radial-gradient(circle at center, #000000, #090909, #000000);
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
}

.diwali-blast-container {
  position: relative;
  width: 300px;
  height: 300px;
}

.blast-center {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 20px;
  height: 20px;
  background: radial-gradient(circle, #ffcc33, #ff6600);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  box-shadow: 0 0 25px #ff6600, 0 0 60px #ffcc33;
  animation: blastPulse 2s infinite ease-in-out;
}

/* Sparks around the center */
.spark {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: radial-gradient(circle, #fff, #ffcc33, #ff6600);
  box-shadow: 0 0 10px #ff6600;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0);
  animation: sparkBlast 2s infinite ease-out;
}

/* Each spark direction and delay */
{% for i in (1..20) %}
.spark-{{ i }} {
  --angle: {{ i | times: 18 }}deg;
  --delay: {{ i | divided_by: 10.0 }}s;
  animation-delay: var(--delay);
}
{% endfor %}

/* Keyframes */
@keyframes blastPulse {
  0%, 100% { transform: translate(-50%, -50%) scale(1); opacity: 0.9; }
  50% { transform: translate(-50%, -50%) scale(1.4); opacity: 1; }
}

@keyframes sparkBlast {
  0% {
    opacity: 0;
    transform: translate(-50%, -50%) scale(0);
  }
  10% {
    opacity: 1;
    transform: translate(-50%, -50%) scale(1);
  }
  100% {
    opacity: 0;
    transform: translate(calc(-50% + 200px * cos(var(--angle))), calc(-50% + 200px * sin(var(--angle)))) scale(0.3);
  }
}

/* twinkling stars background */
.diwali-blast-section::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image: radial-gradient(1px 1px at 10px 20px, #fff, transparent),
                    radial-gradient(1.5px 1.5px at 100px 150px, #ffdd33, transparent),
                    radial-gradient(1px 1px at 200px 250px, #ff9933, transparent),
                    radial-gradient(1px 1px at 350px 300px, #ffaa00, transparent);
  background-size: 400px 400px;
  animation: twinkle 8s linear infinite;
  opacity: 0.4;
}

@keyframes twinkle {
  0% { background-position: 0 0, 200px 200px, 400px 400px, 600px 600px; }
  100% { background-position: 400px 400px, 600px 600px, 0 0, 200px 200px; }
}

/* smooth glowing spread */
@keyframes sparkSpread {
  0% { transform: translate(-50%, -50%) scale(0); opacity: 0; }
  50% { opacity: 1; transform: translate(-50%, -50%) scale(1.2); }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(2); }
}
</style>

{% schema %}
{
  "name": "Diwali Blast Animation",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Diwali Blast Effect",
      "category": "Custom Sections"
    }
  ]
}
{% endschema %}
